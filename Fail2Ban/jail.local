[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
backend = systemd

maxretry = 3
findtime = 30m
bantime = 1h
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 7d

ignoreip = 127.0.0.1/8 192.168.1.6

[nginx-login]
enabled  = true
port     = http,https
filter   = nginx-login
logpath  = /var/log/nginx/access.log
backend  = auto

maxretry = 5
findtime = 10m
bantime  = 1h
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 24h

ignoreip = 127.0.0.1/8 192.168.1.6

[samba]
enabled = true
port = 445
filter = samba
logpath = /var/log/samba/log.smbd
backend = auto

maxretry = 5
findtime = 10m
bantime  = 1h
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 24h

ignoreip = 127.0.0.1/8 192.168.1.6